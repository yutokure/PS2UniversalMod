#!/bin/sh
# Optional pre-commit check: audit what is about to be committed (the Git index, not the files on disk).
# Not active by default.  Turn it on for this clone only:   git config core.hooksPath tools/git-hooks
# Turn it off again:                                         git config --unset core.hooksPath
# Skip it once:                                              git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 0
for py in "${PS2CAM_PYTHON:-}" python python3 py; do
    [ -n "$py" ] || continue
    "$py" -c "" >/dev/null 2>&1 || continue      # skip a missing interpreter and the Windows Store stub
    "$py" "$root/tools/audit_repo.py" --staged || {
        echo "pre-commit: audit failed; nothing was committed (git commit --no-verify to override)." >&2
        exit 1
    }
    exit 0
done
echo "pre-commit: no working Python found; audit skipped." >&2
exit 0
